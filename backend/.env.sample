# Database
DATABASE_URL=
# App Configuration
APP_NAME="GDG Ibadan Ticketing System"
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
logoUrl=https://images.seeklogo.com/logo-png/39/1/google-developers-logo-png_seeklogo-394547.png
TICKET_JWT_SECRET=
CHECKOUT_REDIRECT_URL=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Monnify
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_REDIRECT_URL=
SHOULD_VERIFY_MONNIFY_SIGNATURE=false (true in prod)

# Outbound mail (Resend SMTP relay)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASSWORD=
RESEND_API_KEY=
FROM_EMAIL="tickets@your-verified-domain.com"
FROM_NAME="GDG Ibadan"
# App-side send caps (0 = none). Resend Pro has no daily cap; on the free tier (~100/day) set MAIL_MAX_PER_DAY=100.
# Resend webhook signing secret (whsec_...) for delivered/bounced/complained events.
# Endpoint to register in Resend: POST <API_URL>/api/v1/webhooks/resend
RESEND_WEBHOOK_SECRET=
MAIL_MAX_PER_HOUR=0
MAIL_MAX_PER_DAY=0
# Public https URL of the banner at the top of admin-composed emails (1200x400 PNG). Empty = small logo.
EMAIL_HEADER_URL=

# Token
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default Superadmin details
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
