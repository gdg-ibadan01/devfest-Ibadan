// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid(7))
  name        String   @unique
  description String
  permissions String[]
  isActive    Boolean  @default(true)
  admins      Admin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("roles")
}

model Admin {
  id          String   @id @default(uuid(7))
  fullName    String
  email       String   @unique
  password    String
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id])
  isActive    Boolean  @default(true)
  invitedById String?
  invitedBy   Admin?   @relation("AdminInvitations", fields: [invitedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admins      Admin[]  @relation("AdminInvitations")
  tickets     Ticket[]

  @@map("admins")
}

model Ticket {
  id               String     @id @default(uuid(7))
  name             String
  description      String
  slug             String     @unique
  eventDates       DateTime[]
  price            Decimal
  discount         Decimal @default(0)
  validityDates    DateTime[]
  maximumSaleUnits Int
  saleStartsAt     DateTime
  saleEndsAt       DateTime
  creatorId        String
  creator          Admin      @relation(fields: [creatorId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("tickets")
}
