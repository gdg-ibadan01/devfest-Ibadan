# Database
DATABASE_URL=
# App Configuration
APP_NAME="GDG Ibadan Ticketing System"
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
logoUrl=https://images.seeklogo.com/logo-png/39/1/google-developers-logo-png_seeklogo-394547.png
TICKET_JWT_SECRET=
CHECKOUT_REDIRECT_URL=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Payment provider for NEW orders: ALATPAY (default) or MONNIFY.
# Existing orders always settle on the provider they were created with.
PAYMENT_PROVIDER=ALATPAY

# ALATPay (sandbox|live). Keys: ALATPay dashboard > Settings > Business.
# Callback URL to register on the ALATPay merchant portal:
#   POST <API_URL>/api/v1/webhooks/alatpay
# Enable "webhook retries" on the ALATPay dashboard (retries at +30m, +1h, +24h).
ALATPAY_ENV=sandbox
# Popup key AND the Ocp-Apim-Subscription-Key for transaction requery (per docs)
ALATPAY_PUBLIC_KEY=
# Optional: only tried for requery if the public key is rejected
ALATPAY_SECRET_KEY=
ALATPAY_WEBHOOK_SECRET=
ALATPAY_BUSINESS_ID=
# Optional: HMAC key for order tokens (defaults to secret key, then webhook secret). openssl rand -hex 32
ALATPAY_ORDER_TOKEN_SECRET=
# Optional: only accept webhooks from these IPs (comma-separated). ALATPay docs: 74.178.162.156
ALATPAY_WEBHOOK_IP_ALLOWLIST=
# Seat reservation while awaiting payment (ALATPay virtual accounts last 30 min)
ALATPAY_ORDER_TTL_MINUTES=30
# Every 5 min, confirm unpaid ALATPay orders from the transactions list (safety net for missed webhooks)
ALATPAY_RECONCILIATION_ENABLED=true
# Optional overrides
# ALATPAY_TRANSACTIONS_BASE_URL=
# ALATPAY_SCRIPT_URL=

# Monnify
MONNIFY_ORDER_TTL_MINUTES=5
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_REDIRECT_URL=
SHOULD_VERIFY_MONNIFY_SIGNATURE=false (true in prod)

# Outbound mail (Resend SMTP relay)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASSWORD=
RESEND_API_KEY=
FROM_EMAIL="tickets@your-verified-domain.com"
FROM_NAME="GDG Ibadan"
# App-side send caps (0 = none). Resend Pro has no daily cap; on the free tier (~100/day) set MAIL_MAX_PER_DAY=100.
# Resend webhook signing secret (whsec_...) for delivered/bounced/complained events.
# Endpoint to register in Resend: POST <API_URL>/api/v1/webhooks/resend
RESEND_WEBHOOK_SECRET=
MAIL_MAX_PER_HOUR=0
MAIL_MAX_PER_DAY=0
# Public https URL of the banner at the top of admin-composed emails (1200x400 PNG). Empty = small logo.
EMAIL_HEADER_URL=

# Token
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default Superadmin details
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
