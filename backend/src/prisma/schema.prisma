generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String     @id @default(uuid(7))
  name        String     @unique
  description String
  permissions String[]
  isActive    Boolean    @default(true)
  admins      Admin[]
  auditLogs   AuditLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@map("roles")
}

model Admin {
  id                  String               @id @default(uuid(7))
  fullName            String
  email               String               @unique
  password            String
  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  isActive            Boolean              @default(true)
  invitedById         String?
  invitedBy           Admin?               @relation("AdminInvitations", fields: [invitedById], references: [id])
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  admins              Admin[]              @relation("AdminInvitations")
  auditLogs           AuditLog[]

  @@map("admins")
  tickets Ticket[]
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  adminId   String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid(7))
  adminId   String
  roleId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Ticket {
  id               String     @id @default(uuid(7))
  name             String
  description      String
  slug             String     @unique
  eventDates       DateTime[]
  price            Decimal
  discount         Decimal    @default(0)
  validityDates    DateTime[]
  maximumSaleUnits Int
  saleStartsAt     DateTime
  saleEndsAt       DateTime
  creatorId        String
  creator          Admin      @relation(fields: [creatorId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("tickets")
}
