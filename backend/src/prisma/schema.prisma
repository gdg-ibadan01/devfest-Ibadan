generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String     @id @default(uuid(7))
  name        String     @unique
  description String
  permissions String[]
  isActive    Boolean    @default(true)
  admins      Admin[]
  auditLogs   AuditLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@map("roles")
}

model Admin {
  id                  String               @id @default(uuid(7))
  fullName            String
  email               String               @unique
  password            String
  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id])
  isActive            Boolean              @default(true)
  invitedById         String?
  invitedBy           Admin?               @relation("AdminInvitations", fields: [invitedById], references: [id])
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  admins              Admin[]              @relation("AdminInvitations")
  auditLogs           AuditLog[]
  tickets             Ticket[]

  @@map("admins")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  adminId   String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid(7))
  adminId   String
  roleId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Ticket {
  id               String     @id @default(uuid(7))
  name             String
  description      String
  slug             String     @unique
  eventDates       DateTime[]
  price            Decimal
  discount         Decimal    @default(0)
  validityDates    DateTime[]
  capacity         Int
  saleStartsAt     DateTime
  saleEndsAt       DateTime
  creatorId        String
  creator          Admin      @relation(fields: [creatorId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  orders Order[]

  @@map("tickets")
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  AWAITING_REFUND
  REFUNDED
}

model Order {
  id                     String      @id @default(uuid(7))
  reference              String      @unique
  ticketId               String
  ticket                 Ticket      @relation(fields: [ticketId], references: [id])
  attendeeFullName       String
  attendeeEmail          String
  attendeePhoneNumber    String?
  gifterName             String?
  gifterEmail            String?
  discount               Decimal
  amount                 Decimal
  currency               String      @default("NGN")
  status                 OrderStatus @default(AWAITING_PAYMENT)
  paymentProvider        String      @default("MONNIFY")
  providerTransactionRef String?
  checkoutUrl            String?
  expiresAt              DateTime
  paidAt                 DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([ticketId, status])
  @@map("orders")
}
